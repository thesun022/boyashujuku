  }
  campaign {
    bigint id PK
    varchar(40) code UK
    varchar(180) title
    datetime(6) starts_at
    datetime(6) ends_at
    boolean requires_third_review
    bigint created_by FK
  }
  project {
    bigint id PK
    bigint campaign_id FK
    varchar(40) code
    varchar(180) title
    enum kind
    enum delivery_mode
    boolean is_required
    bigint created_by FK
  }
  project_review_route {
    bigint project_id PK, FK
    enum stage PK
    bigint reviewer_id FK
  }
  work_item {
    bigint id PK
    bigint project_id FK
    varchar(40) code
    varchar(180) title
    enum kind
    enum editing_mode
    boolean is_required
    enum status
    int lock_version
    bigint changed_by FK
    datetime(6) updated_at
    varchar(20) single_kind
  }
  work_assignment {
    bigint id PK
    bigint work_item_id FK
    bigint membership_id FK
    bigint assigned_by FK
    datetime(6) assigned_at
    datetime(6) ended_at
    bigint active_membership_id
  }
  work_contribution {
    bigint id PK
    bigint work_item_id FK
    bigint membership_id FK
    enum participation
    datetime(6) worked_at
    smallint minutes_spent
    varchar(500) note
    bigint recorded_by FK
  }
  work_status_history {
    bigint id PK
    bigint work_item_id FK
    enum old_status
    enum new_status
    int lock_version
    bigint changed_by FK
    datetime(6) changed_at
  }
  asset {
    bigint id PK
    enum kind
    varchar(180) title
    varchar(1024) uri
    binary(32) sha256
    bigint creator_id FK
    datetime(6) created_at
  }
  project_asset {
    bigint project_id PK, FK
    bigint asset_id PK, FK
  }
  submission {
    bigint id PK
    bigint project_id FK
    int version_no
    bigint previous_id FK
    enum kind
    enum start_stage
    boolean third_required
    bigint submitted_by FK
    datetime(6) submitted_at
    varchar(500) note
  }
  submission_asset {
    bigint submission_id PK, FK
    bigint asset_id PK, FK
  }
  review_record {
    bigint id PK
    bigint submission_id FK
    enum stage
    bigint reviewer_id FK
    bigint membership_id FK
    enum decision
    varchar(1000) feedback
    datetime(6) reviewed_at
  }
  handover_record {
    bigint id PK
    bigint submission_id FK
    bigint from_person_id FK
    bigint to_person_id FK
    enum to_stage
    varchar(500) note
    datetime(6) handed_at
  }
  publication {
    bigint id PK
    bigint submission_id FK, UK
    varchar(60) channel
    varchar(1024) url
    bigint published_by FK
    datetime(6) published_at
  }
  equipment {
    bigint id PK
    varchar(40) code UK
    varchar(100) name
    varchar(100) model
    enum source
    enum inventory_status
    datetime(6) borrowed_at
    datetime(6) due_back_at
    datetime(6) external_returned_at
  }
  equipment_usage {
    bigint id PK
    bigint equipment_id FK
    bigint work_item_id FK
    bigint membership_id FK
    bigint reserved_by FK
    datetime(6) starts_at
    datetime(6) ends_at
    datetime(6) checked_out_at
    datetime(6) returned_at
    datetime(6) cancelled_at
  }
  audit_log {
    bigint id PK
    bigint actor_id FK
    varchar(320) db_session_user
    varchar(48) action_code
    varchar(40) entity_type
    bigint entity_id
    json detail
    datetime(6) occurred_at
  }
