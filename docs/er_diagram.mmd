    datetime(6) created_at
  }
  cohort {
    bigint id PK
    varchar(20) code UK
    varchar(80) label
    smallint intake_year
  }
  membership_period {
    bigint id PK
    bigint person_id FK
    bigint cohort_id FK
    datetime(6) joined_at
    datetime(6) left_at
    bigint open_person_id
  }
  position {
    varchar(20) code PK
    varchar(60) label UK
    tinyint hierarchy_rank UK
  }
  membership_position {
    bigint id PK
    bigint membership_id FK
    varchar(20) position_code FK
    datetime(6) starts_at
    datetime(6) ends_at
  }
  skill {
    bigint id PK
    varchar(40) code UK
    varchar(60) label UK
  }
  person_skill {
    bigint person_id PK, FK
    bigint skill_id PK, FK
  }
  account {
    bigint id PK
    bigint person_id FK, UK
    varchar(80) username UK
    varchar(255) password_hash
    boolean enabled
    datetime(6) created_at
  }
  system_role {
    varchar(40) code PK
    varchar(80) label UK
  }
  permission {
    varchar(40) code PK
    varchar(80) label UK
  }
